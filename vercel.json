{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/robots"
        },
        {
            "source": "/news/:slug",
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": ".*(bot|crawler|spider|facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|discordbot|Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|Applebot|redditbot|Slackbot|DuckDuckBot|Baiduspider|YandexBot|SemrushBot|AhrefsBot).*"
                }
            ],
            "destination": "/api/bot-news?news=:slug"
        },
        {
            "source": "/news/:slug",
            "destination": "/?news=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "cleanUrls": true,
    "trailingSlash": false
}