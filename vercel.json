{
    "rewrites": [
        {
            "source": "/news/:slug",
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": ".*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|discordbot|Googlebot|bingbot|Applebot|Twitterbot|redditbot|Slackbot).*"
                }
            ],
            "destination": "/api/bot-news?news=:slug"
        },
        {
            "source": "/news/:slug",
            "destination": "/?news=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "cleanUrls": true,
    "trailingSlash": false
}